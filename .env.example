# 用户自行配置 HTTPS 反向代理；非标准 HTTPS 端口必须写入地址。
PUBLIC_URL=https://panel.example.com
TZ=Asia/Hong_Kong

# 32 字节随机主密钥的 Base64 表示，例如：openssl rand -base64 32
MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# 中心端启动后先运行 setup-key issue，再通过 /setup 创建首个所有者。
COOKIE_SECURE=true
TRUSTED_PROXIES=127.0.0.1/32,::1/128
SESSION_TTL=12h
LOG_LEVEL=info

# Control 明文 HTTP 端口。生产环境应通过防火墙限制为仅 HTTPS 代理可达。
CONTROL_PORT=19090
