# 对外访问地址。生产环境必须使用可解析到本机的域名；使用非标准 HTTPS
# 端口时，PUBLIC_URL 必须包含端口，例如 https://panel.example.com:8443。
PANEL_DOMAIN=panel.example.com
PUBLIC_URL=https://panel.example.com
TZ=Asia/Hong_Kong

# 数据库密码（请替换为随机长密码）。该值会嵌入连接 URL，因此仅使用
# A-Z、a-z、0-9、点、下划线、波浪号和连字符；例如 openssl rand -hex 32。
POSTGRES_DB=l4d2panel
POSTGRES_USER=l4d2panel
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# 32 字节随机密钥的 Base64 表示，例如：openssl rand -base64 32
MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# 首个所有者在中心端启动后通过网站 /setup 创建，不需要在 .env 保存密码。
COOKIE_SECURE=true
SESSION_TTL=12h
LOG_LEVEL=info

# Linux 或 macOS Docker 宿主机的公开端口，可按部署环境修改；容器内部端口保持不变。
# 使用公开 CA 自动签发证书时，公网 80/443 仍需能到达 Caddy 完成 ACME 验证。
HTTP_PORT=80
HTTPS_PORT=443
