# 用户自行配置 HTTPS 反向代理；非标准 HTTPS 端口必须写入地址。
PUBLIC_URL=https://panel.example.com
TZ=Asia/Hong_Kong

# 默认由中心端首次启动时生成并持久保存到 app_data 卷。
# 迁移旧部署或恢复备份时可取消下一行注释并填入原 32 字节主密钥；
# 它必须与卷内 control-master.key 一致，否则中心端拒绝启动。
# MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# 中心端启动后先运行 setup-key issue，再通过 /setup 创建首个所有者。
COOKIE_SECURE=true
TRUSTED_PROXIES=127.0.0.1/32,::1/128
SESSION_TTL=12h
LOG_LEVEL=info

# Control 明文 HTTP 默认只发布到本机回环地址。
CONTROL_BIND_ADDRESS=127.0.0.1
CONTROL_PORT=19090
