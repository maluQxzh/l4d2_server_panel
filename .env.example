# 对外访问地址。使用非标准 HTTPS 端口时必须包含端口。
PANEL_DOMAIN=panel.example.com
PUBLIC_URL=https://panel.example.com
TZ=Asia/Hong_Kong

# 32 字节随机主密钥的 Base64 表示，例如：openssl rand -base64 32
MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# 首个所有者在中心端启动后通过 /setup 创建。
COOKIE_SECURE=true
SESSION_TTL=12h
LOG_LEVEL=info

# 宿主机公开端口；容器内部端口保持不变。
HTTP_PORT=80
HTTPS_PORT=443
