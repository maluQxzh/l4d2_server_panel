<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>zh-CN</Cultures>
    <PanelVersion Condition="'$(PanelVersion)' == ''">0.1.0</PanelVersion>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)payload</PayloadDir>
    <DefineConstants>PanelVersion=$(PanelVersion);PayloadDir=$(PayloadDir)</DefineConstants>
    <!-- WiX 7 builds require explicit EULA acceptance. Maintainers must first
         satisfy the OSMF terms, including sponsorship when applicable. -->
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
